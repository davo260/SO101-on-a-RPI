<?xml version="1.0"?>
<package format="3">
  <name>so101_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 bridge for so101d: shared memory -> sensor_msgs/JointState, /so101/cmd -> daemon commands</description>
  <maintainer email="dalejandro.vera26@gmail.com">Alejandro Vera</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
